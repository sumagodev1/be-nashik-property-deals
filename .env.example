NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nashik_property_deals
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_REFRESH_TTL=7d

# SMTP / email is NOT configured via env any more. All outbound mail
# (property share, OTPs, PIN recovery, admin notifications) reads the
# active row from the `email_settings` table (Global / Email master).
# Add a configuration and activate it from the admin console at
# /admin/masters/email before enabling any feature that sends email.
#
# Optional: the SMTP password stored in email_settings is encrypted with
# AES-256-GCM. The key is derived from JWT_ACCESS_SECRET by default; set
# EMAIL_ENCRYPTION_KEY (32 bytes, hex or base64) here to use a dedicated
# key instead. Rotating this key invalidates every stored SMTP password.
# EMAIL_ENCRYPTION_KEY=

CORS_ORIGIN=http://localhost:5173

# Public base URL of this backend — used to build absolute image URLs returned
# by the API. Leave empty if the frontend and backend share an origin.
PUBLIC_BASE_URL=

UPLOAD_PUBLIC_DIR=uploads/public
UPLOAD_PRIVATE_DIR=uploads/private
# Per-FILE upload cap, in bytes. 5242880 = 5 MB.
#
# CAREFUL: this single variable is read by FOUR upload paths —
#   middleware/imageMulter.js      (property images, code default 5 MB)
#   services/files/imageUpload.js  (property images, code default 5 MB)
#   services/files/documentUpload.js (documents,     code default 5 MB)
#   services/files/cmsBannerUpload.js (CMS banners,  code default 1 MB)
# so lowering it throttles all four. It was set to 1048576 (1 MB), which
# silently overrode the 5 MB the image/document paths intend and rejected
# ordinary phone photos, while the UI still advertised "max 5 MB each".
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_TOTAL_QUOTA_BYTES=524288000
# Per-property image cap. MUST be kept in step with the frontend's
# IMAGES_MAX_FILES (src/shared/components/PropertyImagesSection.jsx = 10).
# services/files/imageUpload.js falls back to 5 when this is unset, which made
# the UI offer 10 slots while the server rejected the 6th onward.
# multer already allows 10 files per request, so 10 needs no other change.
UPLOAD_MAX_IMAGES_PER_PROPERTY=10

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_PER_MINUTE=1
OTP_RATE_PER_HOUR=5

# Cron token for the cPanel-cron-callable email outbox endpoint.
# Generate a random ≥32-char value and use it in your cron entry, e.g.:
#   */10 * * * * curl -fsS -X POST -H "X-Cron-Token: $TOKEN" https://your-host/api/cron/email-outbox/process
CRON_TOKEN=replace-with-random-32-plus-chars

# Google reCAPTCHA v2 — server-side verification on /auth/login.
# Frontend exposes the site key as VITE_CAPTCHA_KEY. The secret key below must
# stay server-side. In production set RECAPTCHA_REQUIRED=true and fill the secret.
# Locally, leave RECAPTCHA_REQUIRED=false to skip verification during development.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_REQUIRED=true

# T-2026-164: Google Calendar OAuth (Strategy B) live-mode credentials.
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console,
# add the redirect URI below to the "Authorized redirect URIs" list, enable
# the Google Calendar API for the project, then fill the two secrets here.
# These variables MUST stay server-side; they are never read by the FE.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/google-calendar/callback
# GOOGLE_CALENDAR_ID=primary
# Optional: disable the background sync worker (tests + secondary instances).
# GOOGLE_CALENDAR_SYNC_WORKER_ENABLED=true
# GOOGLE_CALENDAR_SYNC_WORKER_INTERVAL_MS=300000
# Optional: explicit FE origin for the /callback -> FE redirect (defaults to
# the first CORS_ORIGIN entry, then http://localhost:5173).
# FRONTEND_ORIGIN=http://localhost:5173
